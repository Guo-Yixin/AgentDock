{
  "name": "agentdock",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/mysql-tests.mjs",
    "desktop:runtime": "node scripts/desktop-runtime.mjs",
    "desktop:dev": "npm run build && npm run desktop:runtime && electron desktop/main.cjs",
    "desktop:build": "npm run build && npm run desktop:runtime && node scripts/desktop-prepare.mjs && electron-builder --win --x64 --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
